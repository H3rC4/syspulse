import { Button, CheckBox, ComboBox, ListView, ScrollView, Slider, LineEdit } from "std-widgets.slint";

export global Theme {
    // Mode flag
    in-out property <bool> is-light-mode: false;
    
    // Dark theme colors (default)
    in-out property <brush> pure-black: #050508;
    in-out property <brush> panel-bg: #0a0a0f;
    in-out property <brush> card-bg: #12121a;
    in-out property <brush> card-bg-hover: #1a1a25;
    in-out property <brush> surface: #1e1e2a;
    
    // Light theme colors
    in-out property <brush> pure-black-light: #ffffff;
    in-out property <brush> panel-bg-light: #f5f5f7;
    in-out property <brush> card-bg-light: #ffffff;
    in-out property <brush> card-bg-hover-light: #f0f0f2;
    in-out property <brush> surface-light: #e8e8ec;
    
    // Colores neón (shared)
    in-out property <brush> neon-cyan: #00f0ff;
    in-out property <brush> neon-cyan-dim: #00f0ff40;
    in-out property <brush> neon-purple: #a855f7;
    in-out property <brush> neon-purple-dim: #a855f740;
    in-out property <brush> neon-green: #00ff9d;
    in-out property <brush> neon-green-dim: #00ff9d40;
    in-out property <brush> neon-orange: #ff8c00;
    in-out property <brush> danger: #ff4d6d;
    in-out property <brush> danger-dim: #ff4d6d40;
    
    // Dark text colors
    in-out property <brush> text-primary: #f0f0f5;
    in-out property <brush> text-secondary: #6b6b80;
    in-out property <brush> text-tertiary: #4a4a5a;
    
    // Light text colors
    in-out property <brush> text-primary-light: #1a1a2e;
    in-out property <brush> text-secondary-light: #5a5a6e;
    in-out property <brush> text-tertiary-light: #8a8a9a;
    
    // Dark border colors
    in-out property <brush> border-color: #1e1e2a;
    in-out property <brush> border-subtle: #15151f;
    
    // Light border colors
    in-out property <brush> border-color-light: #d0d0d8;
    in-out property <brush> border-subtle-light: #e0e0e8;
    
    // Dynamic colors (computed based on mode)
    in-out property <brush> bg-main: #050508;
    in-out property <brush> bg-panel: #0a0a0f;
    in-out property <brush> bg-card: #12121a;
    in-out property <brush> bg-card-hover: #1a1a25;
    in-out property <brush> bg-surface: #1e1e2a;
    in-out property <brush> text-main: #f0f0f5;
    in-out property <brush> text-sub: #6b6b80;
    in-out property <brush> text-dim: #4a4a5a;
    in-out property <brush> border-main: #1e1e2a;
    in-out property <brush> border-dim: #15151f;
}

export struct ProcessEventData {
    id: int,
    timestamp: string,
    name: string,
    pid: int,
    parent-pid: int,
    command-line: string,
    lifetime: string,
}

export struct ProcessEntryData {
    pid: int,
    name: string,
    cpu: string,
    memory: string,
    focused: bool,
}

export struct DuplicateFileData {
    path: string,
    created: string,
    selected: bool,
}

export struct DuplicateGroupData {
    hash: string,
    size: string,
    raw-size: float,
    files: [DuplicateFileData],
}

export struct QuarantineEntryData {
    key: string,
    original-path: string,
    quarantine-path: string,
    size: string,
    quarantined-at: string,
}

export struct CoreUsageData {
    name: string,
    usage: float,
}

export struct DiskInfoData {
    name: string,
    mount-point: string,
    total-bytes: float,
    available-bytes: float,
}

export struct TempInfoData {
    label: string,
    temperature: float,
}

export struct TopProcessData {
    name: string,
    pid: int,
    value: float,
    value-text: string,
    memory-mb: int,
}

export struct NetDeviceData {
    mac: string,
    ip: string,
    hostname: string,
    vendor: string,
    is-trusted: bool,
    is-gateway: bool,
    is-local: bool,
    display-name: string,
    category-label: string,
    first-seen: string,
    last-seen: string,
}

export struct WifiConnectionData {
    is-available: bool,
    adapter-state: string,
    ssid: string,
    bssid: string,
    signal-quality: int,
    rssi-dbm: int,
    channel: int,
    band: string,
    security-level: string,
    phy-type: string,
    tx-rate-mbps: float,
    rx-rate-mbps: float,
    signal-rating: string,
    stability-rating: string,
    recommendation: string,
}

export struct WifiChannelData {
    channel: int,
    band: string,
    network-count: int,
    congestion-score: float,
    is-current: bool,
    is-recommended: bool,
    reason: string,
}

export struct WifiNearbyData {
    ssid: string,
    bssid: string,
    signal: int,
    channel: int,
    band: string,
    security: string,
}

export struct LinkQualityData {
    adapter-name: string,
    local-ip: string,
    gateway-ip: string,
    gateway-health: string,
    internet-health: string,
    gateway-rtt-ms: float,
    internet-rtt-ms: float,
    jitter-ms: float,
    packet-loss: float,
    status-title: string,
    status-description: string,
    recommendation: string,
    technical-summary: string,
    is-connected: bool,
}

export struct SocketConnectionData {
    protocol: string,
    local-endpoint: string,
    remote-endpoint: string,
    state: string,
    pid: int,
    process-name: string,
    is-alive: bool,
}

export struct PieEvidenceData {
    id: int,
    timestamp: string,
    source-module: string,
    event-type: string,
    observable-json: string,
}

export struct PieIncidentData {
    id: int,
    timestamp: string,
    category: string,
    severity: string,
    risk-score: int,
    confidence: float,
    status: string,
    title: string,
    simple-summary: string,
    simple-recommendation: string,
    technical-rule-id: string,
    technical-impact: string,
    technical-mitigation: string,
    diagnostic-limitations: string,
    evidence-count: int,
    evidences: [PieEvidenceData],
}

// ── Helper components (internal, no export needed) ──

component SidebarButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();

    height: 44px;
    background: active ? #00f0ff12 : (touch.has-hover ? #ffffff06 : transparent);
    border-radius: 10px;

    animate background { duration: 250ms; easing: ease-in-out; }

    // Indicador activo (barra lateral)
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height - 16px;
        y: 8px;
        background: active ? Theme.neon-cyan : transparent;
        border-radius: 2px;
        animate background { duration: 250ms; }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        alignment: start;

        Text {
            text: icon;
            font-size: 16px;
            color: active ? Theme.neon-cyan : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            animate color { duration: 250ms; }
        }

        Text {
            text: label;
            font-size: 13px;
            font-weight: active ? 600 : 500;
            letter-spacing: 0.5px;
            color: active ? Theme.text-primary : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            vertical-alignment: center;
            animate color { duration: 250ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component NeonButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    background: primary
        ? (touch.pressed ? #00b8c8 : (touch.has-hover ? #1af0ff : Theme.neon-cyan))
        : (touch.pressed ? #00f0ff25 : (touch.has-hover ? #00f0ff18 : #00f0ff08));
    border-width: primary ? 0px : 1px;
    border-color: primary ? transparent : Theme.neon-cyan;
    border-radius: 10px;
    opacity: enabled ? 1.0 : 0.35;

    animate background { duration: 200ms; easing: ease-in-out; }
    animate opacity { duration: 200ms; }

    Text {
        text: root.text;
        color: primary ? #000 : Theme.neon-cyan;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { if enabled { root.clicked(); } }
    }
}

component SectionTitle inherits Text {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: Theme.text-primary;
}

component SectionDescription inherits Text {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2px;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

component TabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    background: active ? Theme.neon-purple : (touch.has-hover ? Theme.card-bg-hover : Theme.card-bg);
    border-radius: 17px;
    border-width: active ? 0px : 1px;
    border-color: active ? transparent : Theme.border-color;

    animate background { duration: 250ms; easing: ease-in-out; }
    animate border-color { duration: 250ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 7px;
        padding-bottom: 7px;

        Text {
            text: label;
            color: active ? #fff : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-weight: active ? 600 : 500;
            font-size: 12px;
            letter-spacing: 0.4px;
            animate color { duration: 200ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    height: 44px;
    spacing: 16px;

    Text {
        text: label;
        color: Theme.text-primary;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.2px;
        width: 340px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ── Tab components ──

component ProcessHunterTab inherits Rectangle {
    in property <[ProcessEventData]> events: [];
    in-out property <int> selected-id: -1;
    callback refresh();
    callback export-json(int);
    callback export-csv(int);

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "Process Hunter"; }
            SectionDescription { text: "Monitor process creation and detect transient processes. Select a process to export for AI analysis."; }
        }

        HorizontalLayout {
            spacing: 10px;
            NeonButton {
                text: "Refresh";
                clicked => { refresh(); }
            }
            NeonButton {
                text: "Export JSON";
                primary: false;
                enabled: selected-id >= 0;
                clicked => { export-json(selected-id); }
            }
            NeonButton {
                text: "Export CSV";
                primary: false;
                enabled: selected-id >= 0;
                clicked => { export-csv(selected-id); }
            }
        }

        Rectangle {
            background: Theme.card-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            ListView {
                for event[index] in events: Rectangle {
                    height: 56px;
                    background: selected-id == event.id ? #00f0ff10 : transparent;
                    border-radius: 10px;

                    animate background { duration: 200ms; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 16px;

                        Text { text: event.timestamp; color: Theme.text-tertiary; font-size: 11px; font-weight: 500; width: 140px; vertical-alignment: center; }
                        Text { text: event.name; color: Theme.text-primary; font-size: 13px; font-weight: 600; width: 160px; vertical-alignment: center; }
                        Text { text: "PID " + event.pid; color: Theme.neon-cyan; font-size: 11px; font-weight: 600; width: 80px; vertical-alignment: center; }
                        Text { text: event.command-line; color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; vertical-alignment: center; }
                    }

                    TouchArea {
                        clicked => { selected-id = event.id; }
                    }
                }
            }
        }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <string> label: "";
    
    height: 28px;
    background: Theme.surface;
    border-radius: 14px;
    
    Rectangle {
        width: Math.max(28px, parent.width * progress);
        height: 100%;
        background: Theme.neon-cyan;
        border-radius: 14px;
        
        animate width { duration: 300ms; easing: ease-in-out; }
        
        Text {
            text: root.label;
            color: #000;
            font-weight: 600;
            font-size: 11px;
            letter-spacing: 0.3px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CleanerTab inherits Rectangle {
    in property <bool> scanning: false;
    in property <bool> paused: false;
    in property <string> status: "";
    in property <int> files-found: 0;
    in property <int> total-files: 0;
    in property <string> bytes-text: "0 B";
    in property <float> progress: 0.0;
    in property <[DuplicateGroupData]> duplicate-groups: [];
    in property <[QuarantineEntryData]> quarantine-entries: [];
    in-out property <string> folder-path: "";
    in-out property <int> sub-tab: 0;
    in property <string> duplicates-total-mb: "0 MB";
    in property <string> quarantine-total-size: "0 MB";

    callback scan-system-temp();
    callback clean-system-temp();
    callback toggle-pause();
    callback reset-scan();
    callback select-folder();
    callback scan-duplicates(string);
    callback open-file(string);
    callback toggle-file-selection(int, int);
    callback keep-oldest(int);
    callback keep-newest(int);
    callback quarantine-selected();
    callback load-quarantine();
    callback restore(string);
    callback delete(string);
    callback reveal-file(string);

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "Smart Cleaner"; }
            SectionDescription { text: "Clean temporary files and developer caches. Files are sent to the Recycle Bin."; }
        }

        HorizontalLayout {
            spacing: 8px;
            TabPill { label: "System Sweep"; active: sub-tab == 0; clicked => { sub-tab = 0; } }
            TabPill { label: "Duplicates"; active: sub-tab == 1; clicked => { sub-tab = 1; } }
            TabPill { label: "Quarantine"; active: sub-tab == 2; clicked => { sub-tab = 2; load-quarantine(); } }
        }

        if sub-tab == 0: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                NeonButton { 
                    text: scanning && paused ? "Resume" : scanning ? "Pause" : "Scan";
                    clicked => { 
                        if scanning { 
                            toggle-pause(); 
                        } else { 
                            scan-system-temp(); 
                        } 
                    } 
                }
                NeonButton { 
                    text: "Clean"; 
                    primary: false; 
                    enabled: !scanning && files-found > 0; 
                    clicked => { clean-system-temp(); } 
                }
                if scanning || files-found > 0: NeonButton {
                    text: "Reset";
                    primary: false;
                    clicked => { reset-scan(); }
                }
            }

            if scanning: ProgressBar {
                progress: root.progress;
                label: paused ? "Paused - " + status : status;
            }

            if total-files > 0: Text { 
                text: "Cleaning: " + files-found + " / " + total-files + " files"; 
                color: Theme.neon-cyan; 
                font-size: 14px; 
                font-weight: 700; 
            }
            if total-files == 0: Text { 
                text: "Files found: " + files-found; 
                color: Theme.text-primary; 
                font-size: 14px; 
            }
            Text { text: "Reclaimable: " + bytes-text; color: Theme.neon-green; font-size: 14px; font-weight: 700; }
        }

        if sub-tab == 1: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                height: 40px;

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    LineEdit {
                        text <=> folder-path;
                        placeholder-text: "Select a folder...";
                        read-only: true;
                        font-size: 13px;
                    }
                }

                NeonButton { text: "Browse"; primary: false; clicked => { select-folder(); } }
                NeonButton { text: "Scan"; enabled: folder-path != ""; clicked => { scan-duplicates(folder-path); } }
                NeonButton { text: "Send Selected to Quarantine"; primary: false; clicked => { quarantine-selected(); } }
            }

            if duplicate-groups.length > 0 : HorizontalLayout {
                spacing: 16px;
                
                Text { 
                    text: duplicate-groups.length + " duplicate groups found"; 
                    color: Theme.text-primary; 
                    font-size: 14px; 
                }
                
                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Theme.border-color;
                }
                
                Text { 
                    text: "Total: " + duplicates-total-mb; 
                    color: Theme.neon-cyan; 
                    font-size: 14px; 
                    font-weight: 700;
                }
            }

            ScrollView {
                VerticalLayout {
                    spacing: 12px;
                    padding: 8px;

                    for group[group-index] in duplicate-groups: Rectangle {
                        background: Theme.card-bg;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text { text: "Hash: " + group.hash; color: Theme.text-secondary; font-size: 11px; }
                                Text { text: "Size: " + group.size; color: Theme.neon-cyan; font-size: 12px; font-weight: 700; }
                            }

                            for file[index] in group.files: Rectangle {
                                height: 48px;
                                background: file.selected ? #00ff9d10 : transparent;
                                border-radius: 6px;
                                
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        background: file.selected ? Theme.neon-green : Theme.border-color;
                                        border-radius: 4px;
                                        
                                        TouchArea {
                                            clicked => { toggle-file-selection(group-index, index); }
                                        }
                                    }
                                    Text { 
                                        text: file.path; 
                                        color: Theme.text-primary; 
                                        font-size: 12px; 
                                        wrap: word-wrap;
                                        max-width: 600px;
                                    }
                                    Text { 
                                        text: file.created; 
                                        color: Theme.text-secondary; 
                                        font-size: 11px;
                                        width: 120px;
                                    }
                                    NeonButton { 
                                        text: "Open"; 
                                        primary: false;
                                        width: 80px;
                                        clicked => { open-file(file.path); } 
                                    }
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                padding-top: 8px;
                                NeonButton { text: "Keep Oldest"; primary: false; clicked => { keep-oldest(group-index); } }
                                NeonButton { text: "Keep Newest"; primary: false; clicked => { keep-newest(group-index); } }
                            }
                        }
                    }
                }
            }
        }

        if sub-tab == 2: VerticalLayout {
            spacing: 12px;

            HorizontalLayout {
                spacing: 16px;
                NeonButton { text: "Refresh"; primary: false; clicked => { load-quarantine(); } }
                
                if quarantine-entries.length > 0 : Text {
                    text: quarantine-entries.length + " files in quarantine (" + quarantine-total-size + ")";
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            ScrollView {
                VerticalLayout {
                    spacing: 12px;
                    padding: 8px;

                    for entry[index] in quarantine-entries: Rectangle {
                        background: Theme.card-bg;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border-color;
                        height: 80px;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            VerticalLayout {
                                Text { text: entry.original-path; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                                Text { text: entry.size + " \u{2022} " + entry.quarantined-at; color: Theme.text-secondary; font-size: 11px; }
                            }

                            NeonButton { text: "Reveal"; primary: false; clicked => { reveal-file(entry.quarantine-path); } }
                            NeonButton { text: "Restore"; primary: false; clicked => { restore(entry.key); } }
                            NeonButton { text: "Delete"; primary: false; clicked => { delete(entry.key); } }
                        }
                    }
                }
            }
        }
    }
}

component CpuFocusTab inherits Rectangle {
    in property <[ProcessEntryData]> entries: [];
    callback refresh();
    callback toggle(int);

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "CPU Focus"; }
            SectionDescription { text: "Select a process to raise its priority and improve responsiveness."; }
        }

        NeonButton { text: "Refresh"; clicked => { refresh(); } }

        Rectangle {
            background: Theme.card-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            ListView {
                for entry[index] in entries: Rectangle {
                    height: 56px;
                    background: entry.focused ? #a855f710 : transparent;
                    border-radius: 10px;
                    
                    animate background { duration: 200ms; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 16px;

                        Text { text: entry.name; color: Theme.text-primary; font-size: 13px; font-weight: 600; width: 200px; vertical-alignment: center; }
                        Text { text: entry.cpu; color: Theme.neon-cyan; font-size: 12px; font-weight: 600; width: 100px; vertical-alignment: center; }
                        Text { text: entry.memory; color: Theme.text-secondary; font-size: 12px; width: 120px; vertical-alignment: center; }

                        NeonButton {
                            text: entry.focused ? "Unfocus" : "Focus";
                            primary: !entry.focused;
                            clicked => { toggle(entry.pid); }
                        }
                    }
                }
            }
        }
    }
}

component SettingsTab inherits Rectangle {
    in-out property <int> language-index: 0;
    in-out property <bool> dark-mode: true;
    in-out property <bool> light-mode: false;
    in-out property <bool> start-with-os: false;
    in-out property <float> history-days: 30;
    in-out property <float> quarantine-days: 7;
    in-out property <bool> permanent-delete: false;
    in property <string> version: "0.4.0";
    callback save();
    callback check-updates();

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 24px;

        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: language-index == 1 ? "Configuración" : "Settings"; }
            SectionDescription { text: language-index == 1 ? "Configurá idioma, tema y preferencias del sistema." : "Configure language, theme, and system preferences."; }
        }

        // Settings card
        Rectangle {
            background: Theme.card-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;

                SettingRow {
                    label: language-index == 1 ? "Idioma" : "Language";
                    ComboBox {
                        model: ["English", "Espa\u{00F1}ol (Argentina)"];
                        current-index <=> language-index;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: language-index == 1 ? "Modo oscuro" : "Dark mode";
                    CheckBox {
                        checked: dark-mode;
                        toggled => {
                            if self.checked {
                                dark-mode = true;
                                light-mode = false;
                            } else {
                                dark-mode = false;
                                light-mode = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: language-index == 1 ? "Modo claro" : "Light mode";
                    CheckBox {
                        checked: light-mode;
                        toggled => {
                            if self.checked {
                                light-mode = true;
                                dark-mode = false;
                            } else {
                                light-mode = false;
                                dark-mode = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: language-index == 1 ? "Iniciar con el sistema operativo" : "Start with operating system";
                    CheckBox { checked <=> start-with-os; }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: (language-index == 1 ? "Retención del historial: " : "Process history retention: ") + Math.round(history-days) + (language-index == 1 ? " días" : " days");
                    Slider {
                        value <=> history-days;
                        minimum: 1;
                        maximum: 365;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: (language-index == 1 ? "Retención de cuarentena: " : "Quarantine retention: ") + Math.round(quarantine-days) + (language-index == 1 ? " días [Pausada]" : " days [Paused]");
                    Slider {
                        value: quarantine-days;
                        minimum: 1;
                        maximum: 90;
                        enabled: false;
                    }
                }

                Text {
                    text: language-index == 1 ? "\u{2139} Purga automática suspendida por auditoría de seguridad. Los archivos en cuarentena están preservados." : "\u{2139} Auto-purge suspended for security audit. Quarantine files are preserved.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                SettingRow {
                    label: language-index == 1 ? "Borrado permanente (sin Papelera) [Deshabilitado]" : "Permanent delete (bypass Recycle Bin) [Disabled]";
                    CheckBox { checked <=> permanent-delete; enabled: false; }
                }

                Text {
                    text: language-index == 1 ? "\u{2139} El borrado permanente directo está deshabilitado por seguridad. Todo envío va a la Papelera de reciclaje." : "\u{2139} Direct permanent deletion is disabled for safety. All cleanups are sent to the Recycle Bin.";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            NeonButton { text: language-index == 1 ? "Aplicar y Reiniciar" : "Apply & Restart"; clicked => { save(); } }
            NeonButton { text: language-index == 1 ? "Buscar actualizaciones" : "Check for updates"; primary: false; clicked => { check-updates(); } }
        }

        Text { text: language-index == 1 ? "\u{26A0} La aplicación se reiniciará para aplicar el cambio de idioma" : "\u{26A0} App will restart to apply language change"; color: Theme.neon-orange; font-size: 11px; font-weight: 500; }
        Text { text: (language-index == 1 ? "Versión " : "Version ") + version; color: Theme.text-tertiary; font-size: 11px; }
    }
}

component SystemMonitorTab inherits Rectangle {
    in property <float> cpu-usage: 0.0;
    in property <[CoreUsageData]> cores: [];
    in property <float> total-memory: 0.0;
    in property <float> used-memory: 0.0;
    in property <float> total-swap: 0.0;
    in property <float> used-swap: 0.0;
    in property <float> load-avg-1: 0.0;
    in property <float> load-avg-5: 0.0;
    in property <float> load-avg-15: 0.0;
    in property <[DiskInfoData]> disks: [];
    in property <float> network-up: 0.0;
    in property <float> network-down: 0.0;
    in property <[TempInfoData]> temperatures: [];
    in property <float> uptime: 0.0;
    in property <[TopProcessData]> top-cpu: [];
    in property <[TopProcessData]> top-ram: [];
    in property <string> load-avg-text: "0.00 / 0.00 / 0.00";

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 24px;

        // Header
        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "System Monitor"; }
            SectionDescription { text: "Real-time performance metrics"; }
        }

        ScrollView {
            VerticalLayout {
                spacing: 16px;

                // ── Row 1: CPU, RAM, SWAP ──
                HorizontalLayout {
                    spacing: 14px;

                    // CPU Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-cyan-dim;
                                    Text {
                                        text: "\u{26A1}";
                                        font-size: 16px;
                                        color: Theme.neon-cyan;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "CPU Usage"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; }
                                    Text {
                                        text: Math.round(root.cpu-usage) + "%";
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }
                            }

                            ProgressBar {
                                progress: root.cpu-usage / 100.0;
                                label: "";
                            }
                        }
                    }

                    // RAM Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-purple-dim;
                                    Text {
                                        text: "\u{25A8}";
                                        font-size: 16px;
                                        color: Theme.neon-purple;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "MEMORY"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; }
                                    Text {
                                        text: root.total-memory > 0.0 ? Math.round(root.used-memory / 1024 / 1024) + " / " + Math.round(root.total-memory / 1024 / 1024) + " MB" : "N/A";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }
                            }

                            ProgressBar {
                                progress: root.total-memory > 0.0 ? root.used-memory / root.total-memory : 0.0;
                                label: "";
                            }
                        }
                    }

                    // SWAP Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-green-dim;
                                    Text {
                                        text: "\u{21C4}";
                                        font-size: 16px;
                                        color: Theme.neon-green;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "SWAP"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; }
                                    Text {
                                        text: root.total-swap > 0.0 ? Math.round(root.used-swap / 1024 / 1024) + " / " + Math.round(root.total-swap / 1024 / 1024) + " MB" : "N/A";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }
                            }

                            ProgressBar {
                                progress: root.total-swap > 0.0 ? root.used-swap / root.total-swap : 0.0;
                                label: "";
                            }
                        }
                    }
                }

                // ── Row 2: Disks + Network ──
                HorizontalLayout {
                    spacing: 14px;

                    // Disks Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-cyan-dim;
                                    Text {
                                        text: "\u{26C1}";
                                        font-size: 16px;
                                        color: Theme.neon-cyan;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "STORAGE"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            for disk[index] in root.disks : VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: disk.name != "" ? disk.name : disk.mount-point;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: Math.round(disk.available-bytes / 1024 / 1024 / 1024) + " GB free / " + Math.round(disk.total-bytes / 1024 / 1024 / 1024) + " GB";
                                        font-size: 11px;
                                        color: Theme.text-secondary;
                                    }
                                }
                                ProgressBar {
                                    progress: disk.total-bytes > 0.0 ? (disk.total-bytes - disk.available-bytes) / disk.total-bytes : 0.0;
                                    label: "";
                                }
                            }
                        }
                    }

                    // Network Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-purple-dim;
                                    Text {
                                        text: "\u{21C5}";
                                        font-size: 16px;
                                        color: Theme.neon-purple;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "NETWORK"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 20px;

                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "\u{2191} UPLOAD"; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-tertiary; }
                                    Text {
                                        text: root.network-up > 1024.0 ? Math.round(root.network-up / 1024) + " KB/s" : Math.round(root.network-up) + " B/s";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: Theme.neon-green;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "\u{2193} DOWNLOAD"; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-tertiary; }
                                    Text {
                                        text: root.network-down > 1024.0 ? Math.round(root.network-down / 1024) + " KB/s" : Math.round(root.network-down) + " B/s";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: Theme.neon-cyan;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Row 3: Temps + Uptime/Load ──
                HorizontalLayout {
                    spacing: 14px;

                    // Temperatures Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.danger-dim;
                                    Text {
                                        text: "\u{2668}";
                                        font-size: 16px;
                                        color: Theme.danger;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "TEMPERATURES"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            for temp[index] in root.temperatures : HorizontalLayout {
                                spacing: 12px;

                                Text {
                                    text: temp.label;
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                    preferred-width: 120px;
                                }

                                Text {
                                    text: Math.round(temp.temperature) + "\u{00B0}C";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: temp.temperature > 80.0 ? Theme.danger : Theme.neon-green;
                                }
                            }

                            if root.temperatures.length == 0 : Text {
                                text: "No sensors detected";
                                font-size: 12px;
                                color: Theme.text-tertiary;
                            }
                        }
                    }

                    // System Info Card
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-cyan-dim;
                                    Text {
                                        text: "\u{2139}";
                                        font-size: 16px;
                                        color: Theme.neon-cyan;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "SYSTEM INFO"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 24px;

                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "UPTIME"; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-tertiary; }
                                    Text {
                                        text: {
                                            let uptime_int = Math.floor(root.uptime);
                                            let days = Math.floor(uptime_int / 86400);
                                            let hours = Math.floor(Math.mod(uptime_int, 86400) / 3600);
                                            let mins = Math.floor(Math.mod(uptime_int, 3600) / 60);
                                            return days + "d " + hours + "h " + mins + "m";
                                        };
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "LOAD AVERAGE"; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-tertiary; }
                                    Text {
                                        text: root.load-avg-text;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Row 4: Top Processes ──
                HorizontalLayout {
                    spacing: 14px;

                    // Top CPU
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-cyan-dim;
                                    Text {
                                        text: "\u{26A1}";
                                        font-size: 16px;
                                        color: Theme.neon-cyan;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "TOP PROCESSES BY CPU"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            for proc[index] in root.top-cpu : Rectangle {
                                height: 32px;
                                background: Theme.surface;
                                border-radius: 8px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Text {
                                        text: (index + 1) + ".";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.text-tertiary;
                                        preferred-width: 18px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.name;
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { }

                                    Text {
                                        text: proc.value-text + "%";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.neon-cyan;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Top RAM
                    Rectangle {
                        background: Theme.card-bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: Theme.neon-purple-dim;
                                    Text {
                                        text: "\u{25A8}";
                                        font-size: 16px;
                                        color: Theme.neon-purple;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "TOP PROCESSES BY MEMORY"; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; color: Theme.text-secondary; vertical-alignment: center; }
                            }

                            for proc[index] in root.top-ram : Rectangle {
                                height: 32px;
                                background: Theme.surface;
                                border-radius: 8px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Text {
                                        text: (index + 1) + ".";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.text-tertiary;
                                        preferred-width: 18px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: proc.name;
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { }

                                    Text {
                                        text: proc.memory-mb + " MB";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.neon-purple;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Network Guardian Tab ──

component NetworkGuardianTab inherits Rectangle {
    in-out property <int> sub-tab: 0;

    // Devices section
    in property <[NetDeviceData]> devices: [];
    in property <bool> is-scanning: false;
    in property <string> scan-status: "";
    callback refresh-devices();
    callback scan-network();

    // Wi-Fi section
    in property <WifiConnectionData> wifi-info;
    in property <[WifiChannelData]> wifi-channels: [];
    in property <[WifiNearbyData]> wifi-nearby: [];
    in property <bool> is-loading-wifi: false;
    in property <string> wifi-error: "";
    callback refresh-wifi();

    // Link Quality section
    in property <LinkQualityData> link-quality;
    in property <bool> is-checking-link: false;
    in property <string> link-error: "";
    callback refresh-link();

    // Connections section
    in property <[SocketConnectionData]> connections: [];
    in property <bool> is-loading-connections: false;
    callback refresh-connections();

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "Network Guardian"; }
            SectionDescription { text: "Auditoría de red local, diagnóstico Wi-Fi y monitoreo de sockets en tiempo real."; }
        }

        HorizontalLayout {
            spacing: 8px;
            TabPill { label: "Dispositivos"; active: sub-tab == 0; clicked => { sub-tab = 0; } }
            TabPill { label: "Wi-Fi Analyzer"; active: sub-tab == 1; clicked => { sub-tab = 1; } }
            TabPill { label: "Calidad de Enlace"; active: sub-tab == 2; clicked => { sub-tab = 2; } }
            TabPill { label: "Conexiones"; active: sub-tab == 3; clicked => { sub-tab = 3; } }
        }

        // Subtab 0: Devices
        if sub-tab == 0: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                NeonButton {
                    text: "Actualizar";
                    clicked => { refresh-devices(); }
                }

                NeonButton {
                    text: is-scanning ? "Escaneando..." : "Escanear Red";
                    primary: false;
                    enabled: !is-scanning;
                    clicked => { scan-network(); }
                }

                Rectangle { }

                Text {
                    text: devices.length + " dispositivos";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            if is-scanning: Rectangle {
                height: 38px;
                background: Theme.card-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.neon-cyan-dim;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.neon-cyan;
                    }

                    Text {
                        text: scan-status != "" ? scan-status : "Escaneando subred local con solicitudes ARP acotadas...";
                        font-size: 12px;
                        color: Theme.neon-cyan;
                        vertical-alignment: center;
                    }
                }
            }

            if devices.length == 0 && !is-scanning: Rectangle {
                height: 180px;
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "\u{25CE}";
                        font-size: 32px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "No se encontraron dispositivos en la caché de red local";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Pulsa Actualizar para inspeccionar la tabla ARP del kernel o Escanear Red para un barrido no invasivo.";
                        font-size: 12px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }
                }
            }

            if devices.length > 0: Rectangle {
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                ListView {
                    for dev[index] in devices: Rectangle {
                        height: 58px;
                        background: Math.mod(index, 2) == 1 ? #ffffff03 : transparent;
                        border-radius: 8px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;

                            VerticalLayout {
                                width: 220px;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: dev.display-name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }

                                Text {
                                    text: dev.category-label;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: dev.ip;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.neon-cyan;
                                }

                                Text {
                                    text: dev.mac;
                                    font-size: 11px;
                                    color: Theme.text-tertiary;
                                }
                            }

                            Text {
                                text: dev.vendor;
                                font-size: 12px;
                                color: Theme.text-secondary;
                                width: 150px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                Rectangle {
                                    height: 22px;
                                    border-radius: 6px;
                                    background: dev.is-trusted ? #00ff9d18 : #ffffff08;
                                    border-width: 1px;
                                    border-color: dev.is-trusted ? Theme.neon-green : Theme.border-color;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: dev.is-trusted ? "Confiable" : "Desconocido";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: dev.is-trusted ? Theme.neon-green : Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if dev.is-gateway: Rectangle {
                                    height: 22px;
                                    border-radius: 6px;
                                    background: #00f0ff18;
                                    border-width: 1px;
                                    border-color: Theme.neon-cyan;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Router";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.neon-cyan;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if dev.is-local: Rectangle {
                                    height: 22px;
                                    border-radius: 6px;
                                    background: #a855f718;
                                    border-width: 1px;
                                    border-color: Theme.neon-purple;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Este PC";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.neon-purple;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle { }

                            Text {
                                text: dev.last-seen;
                                font-size: 11px;
                                color: Theme.text-tertiary;
                                width: 130px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }
        }

        // Subtab 1: Wi-Fi Analyzer
        if sub-tab == 1: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                NeonButton {
                    text: is-loading-wifi ? "Escaneando..." : "Actualizar Wi-Fi";
                    enabled: !is-loading-wifi;
                    clicked => { refresh-wifi(); }
                }
            }

            if !wifi-info.is-available: Rectangle {
                height: 140px;
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "\u{26A0}";
                        font-size: 28px;
                        color: Theme.neon-orange;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Adaptador Wi-Fi desconectado o no disponible";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: wifi-error != "" ? wifi-error : "Verifica que el Wi-Fi esté encendido o que el equipo no esté conectado exclusivamente por Ethernet.";
                        font-size: 12px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }
                }
            }

            if wifi-info.is-available: VerticalLayout {
                spacing: 16px;

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                text: "Conexión Activa: " + (wifi-info.ssid != "" ? wifi-info.ssid : "Sin red");
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.neon-cyan;
                            }

                            Rectangle { }

                            Text {
                                text: wifi-info.bssid != "" ? ("BSSID: " + wifi-info.bssid) : "";
                                font-size: 11px;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 24px;

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Señal"; font-size: 11px; color: Theme.text-tertiary; }
                                Text {
                                    text: wifi-info.signal-quality + "% (" + wifi-info.rssi-dbm + " dBm)";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.neon-green;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Canal & Banda"; font-size: 11px; color: Theme.text-tertiary; }
                                Text {
                                    text: "Canal " + wifi-info.channel + " (" + wifi-info.band + ")";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Seguridad"; font-size: 11px; color: Theme.text-tertiary; }
                                Text {
                                    text: wifi-info.security-level;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Velocidad de Enlace"; font-size: 11px; color: Theme.text-tertiary; }
                                Text {
                                    text: wifi-info.rx-rate-mbps + " / " + wifi-info.tx-rate-mbps + " Mbps";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Protocolo PHY"; font-size: 11px; color: Theme.text-tertiary; }
                                Text {
                                    text: wifi-info.phy-type != "" ? wifi-info.phy-type : "Desconocido";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                }
                            }
                        }

                        if wifi-info.recommendation != "": Rectangle {
                            height: 32px;
                            background: #00ff9d10;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #00ff9d30;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Recomendación: " + wifi-info.recommendation;
                                    font-size: 11px;
                                    color: Theme.neon-green;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 12px;

                        Text {
                            text: "Mapa de Canales Circundantes y Congestión";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        if wifi-channels.length == 0: Text {
                            text: "No se registran datos de canales circundantes. Pulsa Actualizar Wi-Fi para iniciar un escaneo pasivo.";
                            font-size: 12px;
                            color: Theme.text-tertiary;
                        }

                        if wifi-channels.length > 0: ListView {
                            for ch in wifi-channels: Rectangle {
                                height: 42px;
                                border-radius: 6px;

                                HorizontalLayout {
                                    spacing: 16px;

                                    Text {
                                        text: "Canal " + ch.channel;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: ch.is-current ? Theme.neon-cyan : Theme.text-primary;
                                        width: 80px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: ch.band;
                                        font-size: 11px;
                                        color: Theme.text-secondary;
                                        width: 70px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: ch.network-count + " redes";
                                        font-size: 11px;
                                        color: Theme.text-tertiary;
                                        width: 70px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        width: 140px;
                                        height: 10px;
                                        background: Theme.surface;
                                        border-radius: 5px;

                                        Rectangle {
                                            width: Math.min(parent.width, Math.max(10px, parent.width * (ch.congestion-score / 100.0)));
                                            height: 100%;
                                            border-radius: 5px;
                                            background: ch.congestion-score > 60.0 ? Theme.danger : (ch.congestion-score > 30.0 ? Theme.neon-orange : Theme.neon-green);
                                        }
                                    }

                                    if ch.is-current: Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #00f0ff18;
                                        border-width: 1px;
                                        border-color: Theme.neon-cyan;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text { text: "ACTUAL"; font-size: 9px; font-weight: 700; color: Theme.neon-cyan; vertical-alignment: center; }
                                        }
                                    }

                                    if ch.is-recommended: Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #00ff9d18;
                                        border-width: 1px;
                                        border-color: Theme.neon-green;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text { text: "RECOMENDADO"; font-size: 9px; font-weight: 700; color: Theme.neon-green; vertical-alignment: center; }
                                        }
                                    }

                                    Rectangle { }

                                    Text {
                                        text: ch.reason;
                                        font-size: 11px;
                                        color: Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Subtab 2: Link Quality
        if sub-tab == 2: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                NeonButton {
                    text: is-checking-link ? "Midiendo..." : "Verificar Calidad de Enlace";
                    enabled: !is-checking-link;
                    clicked => { refresh-link(); }
                }
            }

            Rectangle {
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: link-quality.is-connected ? Theme.border-subtle : Theme.danger-dim;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 8px;

                    HorizontalLayout {
                        Text {
                            text: link-quality.status-title != "" ? link-quality.status-title : "Estado de Conexión";
                            font-size: 16px;
                            font-weight: 700;
                            color: link-quality.is-connected ? Theme.neon-green : Theme.danger;
                        }

                        Rectangle { }

                        Text {
                            text: "Adaptador: " + link-quality.adapter-name;
                            font-size: 11px;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: link-quality.status-description != "" ? link-quality.status-description : "Evaluando estado del enlace...";
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text { text: "IP Local: " + link-quality.local-ip; font-size: 11px; color: Theme.text-tertiary; }
                        Text { text: "Gateway: " + link-quality.gateway-ip; font-size: 11px; color: Theme.text-tertiary; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "Latencia Gateway"; font-size: 11px; color: Theme.text-tertiary; }
                        Text {
                            text: link-quality.gateway-rtt-ms >= 0.0 ? (link-quality.gateway-rtt-ms + " ms") : "Inalcanzable";
                            font-size: 20px;
                            font-weight: 700;
                            color: link-quality.gateway-rtt-ms >= 0.0 && link-quality.gateway-rtt-ms < 20.0 ? Theme.neon-green : (link-quality.gateway-rtt-ms < 50.0 ? Theme.neon-cyan : Theme.neon-orange);
                        }
                        Text { text: link-quality.gateway-health; font-size: 11px; color: Theme.text-secondary; }
                    }
                }

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "Latencia Internet"; font-size: 11px; color: Theme.text-tertiary; }
                        Text {
                            text: link-quality.internet-rtt-ms >= 0.0 ? (link-quality.internet-rtt-ms + " ms") : "Inalcanzable";
                            font-size: 20px;
                            font-weight: 700;
                            color: link-quality.internet-rtt-ms >= 0.0 && link-quality.internet-rtt-ms < 50.0 ? Theme.neon-green : (link-quality.internet-rtt-ms < 100.0 ? Theme.neon-cyan : Theme.neon-orange);
                        }
                        Text { text: link-quality.internet-health; font-size: 11px; color: Theme.text-secondary; }
                    }
                }

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "Jitter RFC 3550"; font-size: 11px; color: Theme.text-tertiary; }
                        Text {
                            text: link-quality.jitter-ms + " ms";
                            font-size: 20px;
                            font-weight: 700;
                            color: link-quality.jitter-ms < 10.0 ? Theme.neon-green : (link-quality.jitter-ms < 25.0 ? Theme.neon-cyan : Theme.neon-orange);
                        }
                        Text { text: "Variabilidad temporal"; font-size: 11px; color: Theme.text-secondary; }
                    }
                }

                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text { text: "Pérdida de Paquetes"; font-size: 11px; color: Theme.text-tertiary; }
                        Text {
                            text: link-quality.packet-loss + " %";
                            font-size: 20px;
                            font-weight: 700;
                            color: link-quality.packet-loss == 0.0 ? Theme.neon-green : (link-quality.packet-loss < 5.0 ? Theme.neon-orange : Theme.danger);
                        }
                        Text { text: link-quality.packet-loss == 0.0 ? "Enlace estable" : "Descartes detectados"; font-size: 11px; color: Theme.text-secondary; }
                    }
                }
            }

            if link-quality.recommendation != "" || link-quality.technical-summary != "": Rectangle {
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    if link-quality.recommendation != "": HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Recomendación:"; font-size: 12px; font-weight: 700; color: Theme.neon-cyan; width: 110px; }
                        Text { text: link-quality.recommendation; font-size: 12px; color: Theme.text-primary; wrap: word-wrap; }
                    }

                    if link-quality.technical-summary != "": HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Resumen Técnico:"; font-size: 12px; font-weight: 700; color: Theme.neon-purple; width: 110px; }
                        Text { text: link-quality.technical-summary; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                }
            }
        }

        // Subtab 3: Connections
        if sub-tab == 3: VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                NeonButton {
                    text: is-loading-connections ? "Actualizando..." : "Actualizar Conexiones";
                    enabled: !is-loading-connections;
                    clicked => { refresh-connections(); }
                }

                Rectangle { }

                Text {
                    text: connections.length + " sockets activos";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            if connections.length == 0: Rectangle {
                height: 160px;
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "\u{29BF}";
                        font-size: 28px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "No se registran conexiones de red en este momento";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Pulsa Actualizar Conexiones para consultar los sockets TCP y UDP del sistema mediante GetExtendedTcpTable.";
                        font-size: 12px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }
                }
            }

            if connections.length > 0: Rectangle {
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                ListView {
                    for conn[index] in connections: Rectangle {
                        height: 48px;
                        background: Math.mod(index, 2) == 1 ? #ffffff03 : transparent;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;

                            Rectangle {
                                width: 50px;
                                height: 22px;
                                border-radius: 6px;
                                background: conn.protocol == "TCP" ? #00f0ff18 : #a855f718;
                                border-width: 1px;
                                border-color: conn.protocol == "TCP" ? Theme.neon-cyan : Theme.neon-purple;

                                Text {
                                    text: conn.protocol;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: conn.protocol == "TCP" ? Theme.neon-cyan : Theme.neon-purple;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: conn.local-endpoint;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                width: 170px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: conn.remote-endpoint;
                                font-size: 12px;
                                color: conn.remote-endpoint == "-" ? Theme.text-tertiary : Theme.neon-cyan;
                                width: 170px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: conn.state;
                                font-size: 11px;
                                font-weight: 600;
                                color: conn.state == "ESTABLISHED" ? Theme.neon-green : (conn.state == "LISTEN" ? Theme.neon-cyan : Theme.text-secondary);
                                width: 110px;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: conn.process-name + " (PID " + conn.pid + ")";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: conn.is-alive ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: conn.is-alive ? #00ff9d15 : #ffffff08;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: conn.is-alive ? "Activo" : "Cerrado";
                                            font-size: 9px;
                                            font-weight: 600;
                                            color: conn.is-alive ? Theme.neon-green : Theme.text-tertiary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── PIE Incidents Center Tab ──

component PieIncidentsTab inherits Rectangle {
    in property <[PieIncidentData]> incidents: [];
    in-out property <int> selected-id: -1;
    in-out property <PieIncidentData> selected-incident;
    in-out property <int> filter-status: 0; // 0: All, 1: Active, 2: Resolved
    in-out property <bool> is-advanced-view: false;
    in property <bool> is-loading: false;
    in property <string> error-message: "";

    callback refresh();
    callback filter-changed(int);
    callback export-json();
    callback export-csv();

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 28px;
        padding-bottom: 28px;
        spacing: 20px;

        // Header Title & Description
        VerticalLayout {
            spacing: 6px;
            SectionTitle { text: "Centro de Inteligencia y Diagnósticos"; }
            SectionDescription { text: "Diagnósticos correlacionados de seguridad y rendimiento entre sistema, red y procesos."; }
        }

        // Toolbar: Filters, Mode Toggle & Actions
        HorizontalLayout {
            spacing: 10px;

            // Filtros de estado
            TabPill {
                label: "Todos";
                active: filter-status == 0;
                clicked => { filter-status = 0; filter-changed(0); }
            }
            TabPill {
                label: "Activos";
                active: filter-status == 1;
                clicked => { filter-status = 1; filter-changed(1); }
            }
            TabPill {
                label: "Resueltos";
                active: filter-status == 2;
                clicked => { filter-status = 2; filter-changed(2); }
            }

            Rectangle { width: 12px; }

            // Modo Simple vs Avanzado Toggle
            TabPill {
                label: is-advanced-view ? "Vista: Avanzada" : "Vista: Simple";
                active: is-advanced-view;
                clicked => { is-advanced-view = !is-advanced-view; }
            }

            Rectangle { }

            NeonButton {
                text: is-loading ? "Actualizando..." : "Actualizar";
                enabled: !is-loading;
                clicked => { refresh(); }
            }

            NeonButton {
                text: "Exportar JSON";
                primary: false;
                clicked => { export-json(); }
            }

            NeonButton {
                text: "Exportar CSV";
                primary: false;
                clicked => { export-csv(); }
            }
        }

        // Error Banner
        if error-message != "": Rectangle {
            height: 42px;
            background: #ff4d6d18;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.danger;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Text {
                    text: "\u{26A0}";
                    font-size: 16px;
                    color: Theme.danger;
                    vertical-alignment: center;
                }

                Text {
                    text: error-message;
                    font-size: 12px;
                    color: Theme.danger;
                    vertical-alignment: center;
                }
            }
        }

        // Loading Banner
        if is-loading: Rectangle {
            height: 38px;
            background: Theme.card-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.neon-cyan-dim;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.neon-cyan;
                }

                Text {
                    text: "Consultando incidentes e historial forense...";
                    font-size: 12px;
                    color: Theme.neon-cyan;
                    vertical-alignment: center;
                }
            }
        }

        // Empty State
        if incidents.length == 0 && !is-loading && error-message == "": Rectangle {
            height: 220px;
            background: Theme.card-bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "\u{2728}";
                    font-size: 34px;
                    color: Theme.neon-green;
                    horizontal-alignment: center;
                }

                Text {
                    text: "No se registran incidentes";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Todos los subsistemas (Sistema, Red y Procesos) operan dentro de parámetros normales.";
                    font-size: 12px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }

        // Master-Detail Layout when incidents exist
        if incidents.length > 0: HorizontalLayout {
            spacing: 16px;

            // Columna Izquierda: Lista de Incidentes (Master)
            Rectangle {
                width: 380px;
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                ListView {
                    for inc[index] in incidents: Rectangle {
                        height: 84px;
                        background: selected-id == inc.id ? #00f0ff14 : (touch.has-hover ? #ffffff06 : transparent);
                        border-radius: 8px;

                        animate background { duration: 150ms; }

                        touch := TouchArea {
                            clicked => {
                                selected-id = inc.id;
                                selected-incident = inc;
                            }
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 6px;

                            // Badges fila superior: Severidad, Estado, Timestamp
                            HorizontalLayout {
                                spacing: 8px;

                                // Severidad
                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: inc.severity == "critical" ? #ff4d6d22 : (inc.severity == "high" ? #ff8c0022 : (inc.severity == "medium" ? #a855f722 : #00f0ff18));
                                    border-width: 1px;
                                    border-color: inc.severity == "critical" ? Theme.danger : (inc.severity == "high" ? Theme.neon-orange : (inc.severity == "medium" ? Theme.neon-purple : Theme.neon-cyan));

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: inc.severity == "critical" ? "CRÍTICO" : (inc.severity == "high" ? "ALTO" : (inc.severity == "medium" ? "MEDIO" : "INFO"));
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: inc.severity == "critical" ? Theme.danger : (inc.severity == "high" ? Theme.neon-orange : (inc.severity == "medium" ? Theme.neon-purple : Theme.neon-cyan));
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Estado
                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: inc.status == "active" ? #ff4d6d15 : #00ff9d15;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: inc.status == "active" ? "ACTIVO" : "RESUELTO";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: inc.status == "active" ? Theme.danger : Theme.neon-green;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle { }

                                Text {
                                    text: inc.timestamp;
                                    font-size: 10px;
                                    color: Theme.text-tertiary;
                                    vertical-alignment: center;
                                }
                            }

                            // Título
                            Text {
                                text: inc.title;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }

                            // Categoría y evidencias
                            HorizontalLayout {
                                Text {
                                    text: inc.category;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                }

                                Rectangle { }

                                Text {
                                    text: inc.evidence-count + " evidencias";
                                    font-size: 11px;
                                    color: Theme.neon-cyan;
                                }
                            }
                        }
                    }
                }
            }

            // Columna Derecha: Detalle del Incidente Seleccionado (Detail)
            Rectangle {
                background: Theme.card-bg;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                if selected-id < 0: VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Text {
                        text: "\u{2318}";
                        font-size: 28px;
                        color: Theme.text-tertiary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Selecciona un incidente de la lista para ver su análisis";
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                if selected-id >= 0: ScrollView {
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 20px;
                        padding-bottom: 20px;
                        spacing: 16px;

                        // Cabecera del Incidente
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: selected-incident.title;
                                font-size: 18px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                Text {
                                    text: "Categoría: " + selected-incident.category;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                }

                                Text {
                                    text: "Puntuación de Riesgo: " + selected-incident.risk-score + "/100";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: selected-incident.risk-score > 70 ? Theme.danger : (selected-incident.risk-score > 40 ? Theme.neon-orange : Theme.neon-green);
                                }

                                Text {
                                    text: "Confianza: " + Math.round(selected-incident.confidence * 100) + "%";
                                    font-size: 12px;
                                    color: Theme.neon-cyan;
                                }
                            }
                        }

                        // Modo Simple
                        if !is-advanced-view: VerticalLayout {
                            spacing: 14px;

                            // Tarjeta Resumen
                            Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;
                                    Text {
                                        text: "Diagnóstico Explicable:";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.neon-cyan;
                                    }
                                    Text {
                                        text: selected-incident.simple-summary;
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Tarjeta Recomendación Práctica
                            Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;
                                    Text {
                                        text: "Recomendaciones Sugeridas:";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.neon-green;
                                    }
                                    Text {
                                        text: selected-incident.simple-recommendation;
                                        font-size: 13px;
                                        color: Theme.text-primary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Modo Avanzado (Forense)
                        if is-advanced-view: VerticalLayout {
                            spacing: 14px;

                            // Contexto Técnico y Regla
                            Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        Text {
                                            text: "Regla Heurística:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Theme.neon-purple;
                                            width: 140px;
                                        }
                                        Text {
                                            text: selected-incident.technical-rule-id;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.neon-cyan;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: "Impacto Técnico:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Theme.text-secondary;
                                            width: 140px;
                                        }
                                        Text {
                                            text: selected-incident.technical-impact != "" ? selected-incident.technical-impact : "Evaluación estándar de rendimiento";
                                            font-size: 12px;
                                            color: Theme.text-primary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: "Mitigación Técnica:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Theme.text-secondary;
                                            width: 140px;
                                        }
                                        Text {
                                            text: selected-incident.technical-mitigation != "" ? selected-incident.technical-mitigation : "Verificar telemetría de subsistema";
                                            font-size: 12px;
                                            color: Theme.text-primary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: "Limitaciones:";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Theme.text-tertiary;
                                            width: 140px;
                                        }
                                        Text {
                                            text: selected-incident.diagnostic-limitations != "" ? selected-incident.diagnostic-limitations : "Diagnóstico basado en telemetría observable offline";
                                            font-size: 11px;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Lista de Evidencias Observables
                            Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;

                                    Text {
                                        text: "Evidencias Observables (" + selected-incident.evidence-count + "):";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.neon-cyan;
                                    }

                                    if selected-incident.evidence-count == 0: Text {
                                        text: "No hay registros de evidencias adicionales asociados a este incidente.";
                                        font-size: 11px;
                                        color: Theme.text-tertiary;
                                    }

                                    for ev in selected-incident.evidences: Rectangle {
                                        background: #00000025;
                                        border-radius: 6px;

                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                Text {
                                                    text: ev.timestamp;
                                                    font-size: 10px;
                                                    color: Theme.text-tertiary;
                                                }
                                                Rectangle { }
                                                Text {
                                                    text: ev.source-module + " :: " + ev.event-type;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: Theme.neon-purple;
                                                }
                                            }

                                            Text {
                                                text: ev.observable-json;
                                                font-size: 11px;
                                                color: Theme.text-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── AppWindow (LA UNICA exportada, hereda Window) ─

export component AppWindow inherits Window {
    title: "SysPulse";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.pure-black;

    in-out property <int> current-tab: 0;
    in property <string> status-text: "Ready";
    in property <string> app-version: "0.4.0";
    callback tab-changed(int);

    in property <[ProcessEventData]> process-events: [];
    in-out property <int> selected-process-id: -1;
    callback scan-processes();
    callback export-process(int, string);

    in property <bool> cleaner-scanning: false;
    in property <bool> cleaner-paused: false;
    in property <string> cleaner-status: "";
    in property <int> cleaner-files-found: 0;
    in property <int> cleaner-total-files: 0;
    in property <string> cleaner-bytes-text: "0 B";
    in property <float> cleaner-progress: 0.0;
    in property <[DuplicateGroupData]> duplicate-groups: [];
    in property <[QuarantineEntryData]> quarantine-entries: [];
    in-out property <string> duplicate-folder-path: "";
    in-out property <int> cleaner-sub-tab: 0;
    in property <string> duplicates-total-mb: "0 MB";
    in property <string> quarantine-total-size: "0 MB";
    callback scan-system-temp();
    callback clean-system-temp();
    callback toggle-pause();
    callback reset-scan();
    callback select-folder();
    callback scan-duplicates(string);
    callback open-file(string);
    callback toggle-file-selection(int, int);
    callback keep-oldest(int);
    callback keep-newest(int);
    callback quarantine-selected-duplicates();
    callback load-quarantine();
    callback restore-quarantine(string);
    callback delete-quarantine(string);
    callback reveal-file(string);

    in property <[ProcessEntryData]> process-entries: [];
    callback refresh-processes();
    callback toggle-focus(int);

    in-out property <int> language-index: 0;
    in-out property <bool> dark-mode: true;
    in-out property <bool> light-mode: false;  // NUEVO: para toggle tema claro
    in-out property <bool> start-with-os: false;
    in-out property <float> history-days: 30;
    in-out property <float> quarantine-days: 7;
    in-out property <bool> permanent-delete: false;  // NUEVO: property en AppWindow
    callback save-settings();
    callback check-updates();
    callback set_theme_colors(color, color, color, color, color, color, color, color, color, color);  // NUEVO: para theme switching

    // ── System Monitor properties ──
    in property <float> sys-cpu-usage: 0.0;
    in property <[CoreUsageData]> sys-cores: [];
    in property <float> sys-total-memory: 0.0;
    in property <float> sys-used-memory: 0.0;
    in property <float> sys-total-swap: 0.0;
    in property <float> sys-used-swap: 0.0;
    in property <float> sys-load-avg-1: 0.0;
    in property <float> sys-load-avg-5: 0.0;
    in property <float> sys-load-avg-15: 0.0;
    in property <[DiskInfoData]> sys-disks: [];
    in property <float> sys-network-up: 0.0;
    in property <float> sys-network-down: 0.0;
    in property <[TempInfoData]> sys-temperatures: [];
    in property <float> sys-uptime: 0.0;
    in property <[TopProcessData]> sys-top-cpu: [];
    in property <[TopProcessData]> sys-top-ram: [];
    in property <string> sys-load-avg-text: "0.00 / 0.00 / 0.00";
    callback refresh-sys-stats();

    // ── Network Guardian properties ──
    in property <[NetDeviceData]> net-devices: [];
    in property <bool> net-is-scanning: false;
    in property <string> net-scan-status: "";
    in property <WifiConnectionData> wifi-info;
    in property <[WifiChannelData]> wifi-channels: [];
    in property <[WifiNearbyData]> wifi-nearby: [];
    in property <bool> wifi-is-loading: false;
    in property <string> wifi-error: "";
    in property <LinkQualityData> link-quality;
    in property <bool> link-is-checking: false;
    in property <string> link-error: "";
    in property <[SocketConnectionData]> net-connections: [];
    in property <bool> net-is-loading-connections: false;
    in-out property <int> net-guardian-sub-tab: 0;

    callback refresh-net-devices();
    callback scan-net-devices();
    callback refresh-wifi();
    callback refresh-link-quality();
    callback refresh-net-connections();

    // ── Pulse Intelligence Engine (PIE) Incidents properties ──
    in property <[PieIncidentData]> pie-incidents: [];
    in-out property <int> pie-selected-incident-id: -1;
    in-out property <int> pie-filter-status: 0;
    in-out property <bool> pie-is-advanced-view: false;
    in property <bool> pie-is-loading: false;
    in property <string> pie-error-message: "";

    callback refresh-pie-incidents();
    callback pie-filter-changed(int);
    callback export-pie-forensic-json();
    callback export-pie-forensic-csv();

    HorizontalLayout {
        // ── Sidebar ──
        Rectangle {
            width: 240px;
            background: Theme.panel-bg;

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 28px;
                padding-bottom: 20px;
                spacing: 6px;

                // Logo
                VerticalLayout {
                    padding-bottom: 28px;
                    spacing: 4px;
                    
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        
                        // Logo icon
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: #00f0ff15;
                            
                            Text {
                                text: "\u{2661}";
                                font-size: 18px;
                                color: Theme.neon-cyan;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        
                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: "SysPulse";
                                font-size: 20px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: "v" + root.app-version;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 0.5px;
                                color: Theme.text-tertiary;
                            }
                        }
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
                
                Rectangle { height: 12px; }

                // Section label
                HorizontalLayout {
                    padding-left: 16px;
                    Text {
                        text: "NAVIGATION";
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        color: Theme.text-tertiary;
                    }
                }
                
                Rectangle { height: 4px; }

                SidebarButton {
                    label: "Monitor";
                    icon: "\u{25A0}";
                    active: root.current-tab == 0;
                    clicked => { root.current-tab = 0; root.tab-changed(0); }
                }

                SidebarButton {
                    label: "Process Hunter";
                    icon: "\u{25CE}";
                    active: root.current-tab == 1;
                    clicked => { root.current-tab = 1; root.tab-changed(1); }
                }

                SidebarButton {
                    label: "Cleaner";
                    icon: "\u{2726}";
                    active: root.current-tab == 2;
                    clicked => { root.current-tab = 2; root.tab-changed(2); }
                }

                SidebarButton {
                    label: "CPU Focus";
                    icon: "\u{25B2}";
                    active: root.current-tab == 3;
                    clicked => { root.current-tab = 3; root.tab-changed(3); }
                }

                SidebarButton {
                    label: "Network Guardian";
                    icon: "\u{29BF}";
                    active: root.current-tab == 5;
                    clicked => { root.current-tab = 5; root.tab-changed(5); }
                }

                SidebarButton {
                    label: "Incident Center";
                    icon: "\u{26A0}";
                    active: root.current-tab == 6;
                    clicked => { root.current-tab = 6; root.tab-changed(6); }
                }

                Rectangle { height: 8px; }
                
                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
                
                Rectangle { height: 8px; }
                
                // Section label
                HorizontalLayout {
                    padding-left: 16px;
                    Text {
                        text: "SYSTEM";
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 1.5px;
                        color: Theme.text-tertiary;
                    }
                }
                
                Rectangle { height: 4px; }

                SidebarButton {
                    label: root.language-index == 1 ? "Configuración" : "Settings";
                    icon: "\u{2699}";
                    active: root.current-tab == 4;
                    clicked => { root.current-tab = 4; root.tab-changed(4); }
                }

                Rectangle { }

                // Status bar at bottom
                Rectangle {
                    height: 40px;
                    background: Theme.surface;
                    border-radius: 10px;
                    
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.neon-green;
                        }
                        
                        Text {
                            text: root.status-text;
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── Separator ──
        Rectangle {
            width: 1px;
            background: Theme.border-subtle;
        }

        // ── Main Content ──
        Rectangle {
            background: Theme.pure-black;

            if root.current-tab == 0: SystemMonitorTab {
                cpu-usage: root.sys-cpu-usage;
                cores: root.sys-cores;
                total-memory: root.sys-total-memory;
                used-memory: root.sys-used-memory;
                total-swap: root.sys-total-swap;
                used-swap: root.sys-used-swap;
                load-avg-1: root.sys-load-avg-1;
                load-avg-5: root.sys-load-avg-5;
                load-avg-15: root.sys-load-avg-15;
                disks: root.sys-disks;
                network-up: root.sys-network-up;
                network-down: root.sys-network-down;
                temperatures: root.sys-temperatures;
                uptime: root.sys-uptime;
                top-cpu: root.sys-top-cpu;
                top-ram: root.sys-top-ram;
                load-avg-text: root.sys-load-avg-text;
            }

            if root.current-tab == 1: ProcessHunterTab {
                events: root.process-events;
                selected-id <=> root.selected-process-id;
                refresh => { root.scan-processes(); }
                export-json(id) => { root.export-process(id, "json"); }
                export-csv(id) => { root.export-process(id, "csv"); }
            }

            if root.current-tab == 2: CleanerTab {
                scanning: root.cleaner-scanning;
                paused: root.cleaner-paused;
                status: root.cleaner-status;
                files-found: root.cleaner-files-found;
                total-files: root.cleaner-total-files;
                bytes-text: root.cleaner-bytes-text;
                progress: root.cleaner-progress;
                duplicate-groups: root.duplicate-groups;
                quarantine-entries: root.quarantine-entries;
                folder-path <=> root.duplicate-folder-path;
                sub-tab <=> root.cleaner-sub-tab;
                duplicates-total-mb: root.duplicates-total-mb;
                quarantine-total-size: root.quarantine-total-size;
                scan-system-temp => { root.scan-system-temp(); }
                clean-system-temp => { root.clean-system-temp(); }
                toggle-pause => { root.toggle-pause(); }
                reset-scan => { root.reset-scan(); }
                select-folder => { root.select-folder(); }
                scan-duplicates(path) => { root.scan-duplicates(path); }
                open-file(path) => { root.open-file(path); }
                toggle-file-selection(group_idx, file_idx) => { root.toggle-file-selection(group_idx, file_idx); }
                keep-oldest(index) => { root.keep-oldest(index); }
                keep-newest(index) => { root.keep-newest(index); }
                quarantine-selected => { root.quarantine-selected-duplicates(); }
                load-quarantine => { root.load-quarantine(); }
                restore(key) => { root.restore-quarantine(key); }
                delete(key) => { root.delete-quarantine(key); }
                reveal-file(path) => { root.reveal-file(path); }
            }

            if root.current-tab == 3: CpuFocusTab {
                entries: root.process-entries;
                refresh => { root.refresh-processes(); }
                toggle(pid) => { root.toggle-focus(pid); }
            }

            if root.current-tab == 4: SettingsTab {
                language-index <=> root.language-index;
                dark-mode <=> root.dark-mode;
                light-mode <=> root.light-mode;
                start-with-os <=> root.start-with-os;
                history-days <=> root.history-days;
                quarantine-days <=> root.quarantine-days;
                permanent-delete <=> root.permanent-delete;
                version: root.app-version;
                save => { root.save-settings(); }
                check-updates => { root.check-updates(); }
            }

            if root.current-tab == 5: NetworkGuardianTab {
                sub-tab <=> root.net-guardian-sub-tab;
                devices: root.net-devices;
                is-scanning: root.net-is-scanning;
                scan-status: root.net-scan-status;
                wifi-info: root.wifi-info;
                wifi-channels: root.wifi-channels;
                wifi-nearby: root.wifi-nearby;
                is-loading-wifi: root.wifi-is-loading;
                wifi-error: root.wifi-error;
                link-quality: root.link-quality;
                is-checking-link: root.link-is-checking;
                link-error: root.link-error;
                connections: root.net-connections;
                is-loading-connections: root.net-is-loading-connections;
                refresh-devices => { root.refresh-net-devices(); }
                scan-network => { root.scan-net-devices(); }
                refresh-wifi => { root.refresh-wifi(); }
                refresh-link => { root.refresh-link-quality(); }
                refresh-connections => { root.refresh-net-connections(); }
            }

            if root.current-tab == 6: PieIncidentsTab {
                incidents: root.pie-incidents;
                selected-id <=> root.pie-selected-incident-id;
                filter-status <=> root.pie-filter-status;
                is-advanced-view <=> root.pie-is-advanced-view;
                is-loading: root.pie-is-loading;
                error-message: root.pie-error-message;
                refresh => { root.refresh-pie-incidents(); }
                filter-changed(status) => { root.pie-filter-changed(status); }
                export-json => { root.export-pie-forensic-json(); }
                export-csv => { root.export-pie-forensic-csv(); }
            }
        }
    }
}
